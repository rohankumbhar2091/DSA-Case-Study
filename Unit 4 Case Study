
class StudentDatabase:
    def __init__(self, size=10):
        self.size = size
        self.table = [[] for _ in range(size)]

    def hash_function(self, roll_no):
        return int(roll_no) % self.size

    def insert(self, roll_no, name, branch, marks):
        index = self.hash_function(roll_no)

        for i, student in enumerate(self.table[index]):
            if student[0] == roll_no:
                self.table[index][i] = (
                    roll_no, name, branch, marks
                )
                print("Student record updated successfully!")
                return

        self.table[index].append(
            (roll_no, name, branch, marks)
        )
        print("Student added successfully!")

    def search(self, roll_no):
        index = self.hash_function(roll_no)

        for student in self.table[index]:
            if student[0] == roll_no:
                print("\nStudent Found!")
                print("Roll Number:", student[0])
                print("Name:", student[1])
                print("Branch:", student[2])
                print("Marks:", student[3])
                return

        print("Student record not found!")

    def display(self):
        print("\n--- Student Database ---")
        found = False

        for bucket in self.table:
            for student in bucket:
                print(
                    "Roll No:", student[0],
                    "| Name:", student[1],
                    "| Branch:", student[2],
                    "| Marks:", student[3]
                )
                found = True

        if not found:
            print("Database is empty.")

    def delete(self, roll_no):
        index = self.hash_function(roll_no)

        for student in self.table[index]:
            if student[0] == roll_no:
                self.table[index].remove(student)
                print("Student deleted successfully!")
                return

        print("Student record not found!")


db = StudentDatabase()

while True:
    print("\n===== College Student Database =====")
    print("1. Add Student")
    print("2. Search Student")
    print("3. Display All Students")
    print("4. Delete Student")
    print("5. Exit")

    choice = input("Enter your choice: ")

    if choice == "1":
        roll_no = input("Enter Roll Number: ")
        name = input("Enter Student Name: ")
        branch = input("Enter Branch: ")
        marks = input("Enter Marks: ")
        db.insert(roll_no, name, branch, marks)

    elif choice == "2":
        roll_no = input("Enter Roll Number to Search: ")
        db.search(roll_no)

    elif choice == "3":
        db.display()

    elif choice == "4":
        roll_no = input("Enter Roll Number to Delete: ")
        db.delete(roll_no)

    elif choice == "5":
        print("Exiting Student Database...")
        break

    else:
        print("Invalid choice! Please try again.")
