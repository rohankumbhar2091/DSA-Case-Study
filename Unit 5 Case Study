
import heapq

class CampusNavigation:
    def __init__(self):
        self.graph = {}

    # Add locations and connecting paths
    def add_path(self, location1, location2, distance):
        self.graph.setdefault(location1, []).append(
            (location2, distance)
        )
        self.graph.setdefault(location2, []).append(
            (location1, distance)
        )

    def show_locations(self):
        print("\nAvailable Campus Locations:")
        for location in self.graph:
            print("-", location)

    def find_shortest_route(self, start, destination):
        if start not in self.graph or destination not in self.graph:
            print("Invalid location! Please select a listed location.")
            return

        distances = {
            location: float("inf") for location in self.graph
        }
        previous = {}

        distances[start] = 0
        priority_queue = [(0, start)]

        while priority_queue:
            current_distance, current = heapq.heappop(
                priority_queue
            )

            if current_distance > distances[current]:
                continue

            if current == destination:
                break

            for neighbor, distance in self.graph[current]:
                new_distance = current_distance + distance

                if new_distance < distances[neighbor]:
                    distances[neighbor] = new_distance
                    previous[neighbor] = current

                    heapq.heappush(
                        priority_queue, (new_distance, neighbor)
                    )

        if distances[destination] == float("inf"):
            print("No route available!")
            return

        route = []
        current = destination

        while current != start:
            route.append(current)
            current = previous[current]

        route.append(start)
        route.reverse()

        print("\nShortest Route:")
        print(" -> ".join(route))
        print("Total Distance:", distances[destination], "meters")


campus = CampusNavigation()

campus.add_path("Main Gate", "Parking", 100)
campus.add_path("Main Gate", "Admin Block", 150)
campus.add_path("Parking", "Canteen", 80)
campus.add_path("Admin Block", "Library", 100)
campus.add_path("Canteen", "Library", 120)
campus.add_path("Library", "Computer Department", 70)
campus.add_path("Admin Block", "Computer Department", 250)
campus.add_path("Canteen", "Sports Ground", 150)
campus.add_path("Sports Ground", "Computer Department", 180)

while True:
    print("\n===== College Campus Navigation =====")
    print("1. Show Campus Locations")
    print("2. Find Shortest Route")
    print("3. Exit")

    choice = input("Enter your choice: ")

    if choice == "1":
        campus.show_locations()

    elif choice == "2":
        campus.show_locations()
        start = input("\nEnter starting location: ")
        destination = input("Enter destination: ")
        campus.find_shortest_route(start, destination)

    elif choice == "3":
        print("Thank you for using Campus Navigation!")
        break

    else:
        print("Invalid choice! Try again.")
